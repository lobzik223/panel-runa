# URL бэкенда без завершающего /. В npm run dev можно оставить пустым — запросы к /admin идут через прокси Vite → :4000.
# Продакшен: https://api.seepromnt.com
VITE_API_URL=

# Режим без JWT (только dev): совпадает с ADMIN_PANEL_SECRET на бэкенде, заголовок X-Admin-Key.
# VITE_ADMIN_API_KEY=

# Вход в панель: POST /admin/auth/login (email + пароль из БД panel_admin_accounts). Регистрация: /register с кодом ADMIN_PANEL_INVITE_CODE.
