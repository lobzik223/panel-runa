# URL бэкенда без завершающего /.
# Dev: можно оставить пустым — Vite проксирует /api → http://127.0.0.1:3000
# Prod (сборка для VPS / adm.runa.finance):
#   VITE_API_URL=https://api.runa.finance
VITE_API_URL=

# Создание админа на VPS (в контейнере backend):
#   docker compose -f docker-compose.prod.yml exec backend node scripts/create-admin.js email@domain.com "Password123" "Имя"
#
# Вход: email + пароль, без кода на почту.
# API: POST /api/admin/auth/login → { accessToken, admin }
