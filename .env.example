# URL бэкенда без завершающего /. В npm run dev можно оставить пустым — запросы к /admin идут через прокси Vite → :4000.
# Продакшен (обязательно перед npm run build):
#   VITE_API_URL=https://api.seepromnt.com
VITE_API_URL=

# Тот же секрет, что ADMIN_PANEL_CLIENT_SECRET на бэкенде (мин. 16 символов).
# Без него бэкенд вернёт 403 на все запросы к /admin (если секрет задан на сервере).
# Попадает в JS-сборку — не коммитьте .env с реальным значением в git.
# VITE_ADMIN_PANEL_CLIENT_SECRET=

# Режим без JWT (только dev): совпадает с ADMIN_PANEL_SECRET на бэкенде, заголовок X-Admin-Key.
# VITE_ADMIN_API_KEY=

# Вход: POST /admin/auth/login. Учётные записи: node dist/cli/create-panel-admin.js (см. Backend-Seepromnt).
#
# ─── Продакшен VPS: после правки .env всегда заново: npm run build и обновить dist в nginx ───
# 401 на /admin/auth/login — неверный email/пароль или аккаунт не активирован (email_verified в БД).
# 404 на /admin/site-reviews — на api-сервере старая версия бэкенда без этого маршрута: git pull backend + build + restart.
# 403 — проверьте VITE_ADMIN_PANEL_CLIENT_SECRET и ADMIN_PANEL_CLIENT_SECRET, Origin (ADMIN_PANEL_ALLOWED_ORIGINS), IP (ADMIN_ALLOWED_IPS).
